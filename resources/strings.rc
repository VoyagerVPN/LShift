LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
    LSHIFT_StatusTheCommandExpired L"The command expired."
    LSHIFT_StatusFieldThreadUnavailable L"The field's thread is unavailable."
    LSHIFT_StatusUnsupportedLayout L"The active keyboard layout is not supported."
    LSHIFT_StatusKeyboardLayoutSwitched L"Keyboard layout switched."
    LSHIFT_StatusLayoutChangeUnconfirmed L"The keyboard layout change was not confirmed."
    LSHIFT_StatusTextChangedLayoutUnconfirmed L"Text changed; the keyboard layout change was not confirmed."
    LSHIFT_StatusTextCorrectedKeyboardLayoutSwitched L"Text corrected, keyboard layout switched."
    LSHIFT_StatusCouldNotSafelyReadTheField L"Could not safely read the field."
    LSHIFT_StatusTheTextRangeIsTooLarge L"The text range is too large."
    LSHIFT_StatusTheResultExceedsTheSizeLimit L"The result exceeds the size limit."
    LSHIFT_StatusTheTextOrCursorChanged L"The text or cursor changed."
    LSHIFT_StatusInputConditionsChanged L"Input conditions changed."
    LSHIFT_StatusTheSelectionChangeWasNotConfirmed L"The selection change was not confirmed."
    LSHIFT_StatusSelectionContextChanged L"The context changed after selection; replacement cancelled."
    LSHIFT_StatusTheReplacementWasNotConfirmed L"The replacement was not confirmed."
    LSHIFT_StatusExpectedTextUnconfirmed L"The field did not confirm the expected text."
    LSHIFT_StatusCursorOffsetNotRestored L"Text corrected; the original cursor offset after the word was not restored."
    LSHIFT_StatusCursorOffsetUnconfirmed L"Text corrected; the original cursor offset after the word was not confirmed."
    LSHIFT_StatusCorrectedKeyUnavailable L"The key for the corrected text is unavailable."
    LSHIFT_StatusCorrectedCaseUnconfirmed L"The case of the corrected text was not confirmed."
    LSHIFT_StatusInputChangedBeforeCorrection L"Input conditions changed before the word could be corrected."
    LSHIFT_StatusContextChangedBeforeCorrection L"The context changed before correction was sent."
    LSHIFT_StatusPasteCommandIncomplete L"The system did not accept the entire paste command."
    LSHIFT_StatusPasteSentLayoutUnconfirmed L"Paste sent; the keyboard layout change was not confirmed."
    LSHIFT_StatusCorrectionCommandSentKeyboardLayoutSwitched L"Correction command sent, keyboard layout switched."
    LSHIFT_StatusPasteSentKeyboardLayoutSwitched L"Paste sent, keyboard layout switched."
    LSHIFT_StatusLayoutSwitchedWordUnavailable L"Keyboard layout switched; the recently typed word is unavailable."
    LSHIFT_StatusTypedWordLayoutChanged L"The typed word's keyboard layout changed."
    LSHIFT_StatusTheTypingSequenceIsNotSupported L"The typing sequence is not supported."
    LSHIFT_StatusTypedWordMismatch L"The typed word did not match the text before the cursor."
    LSHIFT_StatusPairedCharacters L"Paired characters near the cursor: correction cancelled."
    LSHIFT_StatusTheTextOrInputPositionChanged L"The text or input position changed."
    LSHIFT_StatusUiAutomationIsUnavailable L"UI Automation is unavailable."
    LSHIFT_StatusTheTargetWindowIsUnavailable L"The target window is unavailable."
    LSHIFT_StatusFocusNotTextField L"Focus could not be confirmed as a text field."
    LSHIFT_StatusTextNotConfirmedEditable L"The text could not be confirmed as editable."
    LSHIFT_StatusSelectionUnavailable L"The selection or input position is unavailable."
    LSHIFT_StatusTheEditableFieldBoundariesAreUnavailable L"The editable field boundaries are unavailable."
    LSHIFT_StatusCopyConditionsChanged L"Copy conditions changed."
    LSHIFT_StatusCouldNotPrepareTheClipboardText L"Could not prepare the clipboard; text unchanged."
    LSHIFT_StatusCopyCommandIncomplete L"The system did not accept the entire copy command."
    LSHIFT_StatusFocusChangedAfterCopyingFurtherActions L"Focus changed after copying; further actions cancelled."
    LSHIFT_StatusCopyUnconfirmed L"Copy was not confirmed; paste and layout change were not sent."
    LSHIFT_StatusCopiedTextTooLarge L"The copied text exceeds the size limit."
    LSHIFT_StatusCouldNotPreparePasteTextUnchanged L"Could not prepare paste; text unchanged."
    LSHIFT_StatusPasteConditionsChangedTextUnchanged L"Paste conditions changed; text unchanged."
    LSHIFT_StatusRequiredLayoutsUnavailable L"The standard English US and Russian keyboard layouts are required."
    LSHIFT_StatusOperationUnconfirmed L"Operation interrupted; the result was not confirmed."
    LSHIFT_StatusCouldNotInitializeWindowsTextAccess L"Could not initialize Windows text access."
    LSHIFT_StatusTextOperationCancelledAfterAnError L"Text operation cancelled after an error."
    LSHIFT_SettingsTitle L"LShift Settings"
    LSHIFT_SettingsHeading L"Settings"
    LSHIFT_EnableGesture L"Enable double left Shift"
    LSHIFT_IntervalLabel L"Time between presses, ms (150–800)"
    LSHIFT_HoldLabel L"Maximum press duration, ms\n(100–500)"
    LSHIFT_AutostartLabel L"Start LShift when signing in to Windows"
    LSHIFT_Explanation L"Corrects the last word or selection\nin an accessible text field."
    LSHIFT_Save L"Save"
    LSHIFT_Cancel L"Cancel"
    LSHIFT_InterfaceLanguage L"Interface language"
    LSHIFT_Validation L"The interval must be 150–800 ms and the press duration must be 100–500 ms."
    LSHIFT_SaveError L"Could not save settings in the LShift folder inside LOCALAPPDATA. Check folder access and free space."
    LSHIFT_AutostartError L"Settings were saved, but startup could not be changed. Check access to current user settings. The application path and argument must be no longer than 260 characters."
    LSHIFT_AutostartTitle L"LShift Startup"
    LSHIFT_TrayEnabledTip L"LShift — double left Shift enabled"
    LSHIFT_TrayPausedTip L"LShift — paused"
    LSHIFT_MenuEnabled L"Enabled"
    LSHIFT_MenuSettings L"Settings…"
    LSHIFT_MenuDiagnostics L"Open diagnostic log"
    LSHIFT_MenuAutostart L"Start when signing in to Windows"
    LSHIFT_MenuExit L"Exit"
    LSHIFT_MenuError L"Could not open the menu. Click again."
    LSHIFT_WindowPrepareError L"Could not prepare the settings window."
    LSHIFT_WindowOpenError L"Could not open settings."
    LSHIFT_DiagnosticsError L"The log is not available yet. Path: LOCALAPPDATA\\LShift\\diagnostics.jsonl"
    LSHIFT_AutostartChangeError L"Could not change startup for the current user."
    LSHIFT_SaveShortError L"Could not save settings."
    LSHIFT_StartupError L"Could not start LShift. Check access to the system tray and input devices."
    LSHIFT_StartupShortError L"Could not start LShift."
    LSHIFT_FieldContextError L"Field context unavailable: stage {stage}, code {code}."
END

